# Agora credentials
# Required: found in Agora Console → your project → "App ID"
NEXT_PUBLIC_AGORA_APP_ID=

# Required: found in Agora Console → your project → "App Certificate"
# Server-side only. Never expose this in client code.
NEXT_AGORA_APP_CERTIFICATE=

# --- Gatekeeper ---
# Public HTTPS URL of this server (cloudflared/ngrok tunnel to http://localhost:3000).
# Agora custom tools require an absolute HTTPS URL. No trailing slash.
# Without it the Grandma agent still starts, but without tools.
PUBLIC_BASE_URL=

# Shared secret Agora sends in the x-tool-secret header; /api/tools/* reject anything else.
# Generate one: openssl rand -hex 24   (empty or "change-me" disables the tools)
TOOL_SECRET=

# Demo persona. Names are shown on the dashboard and in the Verifier greeting only,
# never in the Grandma prompt or tool guidance.
DEMO_GRANDMA_NAME=Rosa
DEMO_FAMILY_NAME=Alex
DEMO_FAMILY_RELATION=grandson

# Operator fallback controls: lets the dashboard (/dashboard?demo=1) inject a caller line or force
# a verification result if the live demo misbehaves. Every use is counted on the dashboard.
# Leave unset in any shared or public deployment.
DEMO_MODE=
